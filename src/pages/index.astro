---
import BaseLayout from '../layouts/BaseLayout.astro'
---

<BaseLayout title="Home">

  <section class="hero">
    <div class="hero-text">
      <p class="label">Cape Town Artisan Bakery</p>
      <h1>Baked with love,<br/>served with warmth.</h1>
      <p class="subtitle">
        Handcrafted bread, pastries, and cakes made fresh
        every morning. Inspired by Japanese softness and
        French technique.
      </p>
      <div class="hero-buttons">
        <a href="/menu"  class="btn-primary">View Our Menu</a>
        <a href="/order" class="btn-outline">Order Online</a>
      </div>
    </div>

    <div class="hero-image">
      <img src="/images/hero-bread.jpg" alt="Fresh bread from Hana Loaf" />
    </div>
  </section>

  <section class="features">
    <div class="feature">
      <span>🌾</span>
      <h3>Heritage Flour</h3>
      <p>Stone-ground grain sourced from local South African mills every week.</p>
    </div>
    <div class="feature">
      <span>🧈</span>
      <h3>Real Butter Only</h3>
      <p>No shortcuts. Every layer of pastry uses pure cultured butter.</p>
    </div>
    <div class="feature">
      <span>🌸</span>
      <h3>Baked Fresh Daily</h3>
      <p>Everything is made from scratch each morning. No day-old anything.</p>
    </div>
  </section>

  <section class="quote">
    <blockquote>
      "Good bread should do more than just taste good —
      it should make you slow down for a moment."
    </blockquote>
    <cite>— Hana Loaf, est. 2018</cite>
  </section>

  <section class="cta">
    <h2>Ready to order?</h2>
    <p>Custom cakes, pastry boxes, and fresh bread available for pickup.</p>
    <a href="/order" class="btn-primary">Order Now 🌸</a>
  </section>

</BaseLayout>
